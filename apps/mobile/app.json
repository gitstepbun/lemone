{
  "expo": {
    "name": "Lemone Chat",
    "slug": "lemone-chat",
    "scheme": "lemone.chat",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "chat.lemone.app",
      "supportsTablet": false,
      "associatedDomains": ["applinks:lemone.chat"]
    },
    "android": {
      "package": "chat.lemone.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "lemone.chat", "pathPrefix": "/mobile/callback" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": ["expo-secure-store", "expo-web-browser"],
    "extra": {
      "oidcIssuer": "https://auth.lemone.work/realms/lemone",
      "apiUrl": "https://lemone.chat/api",
      "wsUrl": "wss://lemone.chat/ws",
      "androidClientId": "lemone-chat-android",
      "iosClientId": "lemone-chat-ios"
    }
  }
}
