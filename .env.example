# Salin ke .env lalu isi. Jangan commit .env.
# ---- Postgres (docker) ----
PG_SUPERUSER=lemone
PG_SUPERPASSWORD=ganti-saya
PG_PORT=5432
KC_DB_PASSWORD=ganti-saya
API_DB_PASSWORD=ganti-saya

# ---- Keycloak (docker, dev) ----
KC_ADMIN_USER=kcadmin
KC_ADMIN_PASSWORD=ganti-saya
KC_PORT=8080
# URL publik IdP. Dev: http://localhost:8080 . Produksi di belakang nginx: https://lemone.work/auth
KC_PUBLIC_URL=http://localhost:8080

# ---- API (apps/api) ----
API_PORT=4000
DATABASE_URL=postgres://lemone_api:ganti-saya@localhost:5432/lemone
# Issuer OIDC (boleh berisi path realm)
OIDC_ISSUER=http://localhost:8080/realms/lemone
# URL admin Keycloak dipakai backend saja (service account)
KC_ADMIN_URL=http://localhost:8080
KC_REALM=lemone
IDP_PROVISIONER_CLIENT_ID=lemone-provisioner
IDP_PROVISIONER_CLIENT_SECRET=diisi-oleh-pnpm-idp:bootstrap
# Client confidential untuk BFF web
OIDC_CLIENT_WORK_ID=lemone-work-web
OIDC_CLIENT_WORK_SECRET=diisi-oleh-pnpm-idp:bootstrap
OIDC_CLIENT_CHAT_ID=lemone-chat-web
OIDC_CLIENT_CHAT_SECRET=diisi-oleh-pnpm-idp:bootstrap
# Audience access token yang diterima API
API_AUDIENCE=lemone-api
# Host publik tiap aplikasi (allowlist redirect, cookie host-only)
WORK_PUBLIC_URL=http://localhost:3001
CHAT_PUBLIC_URL=http://localhost:3002
# WebSocket Chat untuk build chat-web produksi (wss://lemone.chat/ws)
CHAT_WS_URL=ws://localhost:4000/ws
# Kunci enkripsi token sesi di DB (32 byte base64). Buat: openssl rand -base64 32
SESSION_ENC_KEY=ganti-saya
# Masa berlaku undangan (jam)
INVITATION_TTL_HOURS=24
# Username inbox HR dan nama layanan
HR_INBOX_USERNAME=hr
# Aktifkan prosedur bootstrap owner pertama (matikan setelah dipakai)
BOOTSTRAP_ENABLED=false
# ERP: demo | http
ERP_ADAPTER=demo
ERP_BASE_URL=
ERP_API_KEY=
# AI: none | anthropic
AI_PROVIDER=none
AI_API_KEY=

# ---- Web (apps/work-web, apps/chat-web) ----
# Alamat API yang di-proxy oleh Next (server side)
API_INTERNAL_URL=http://localhost:4000
